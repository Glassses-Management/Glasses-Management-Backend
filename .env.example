# Copy this file to ".env" and fill in YOUR OWN values.
# ".env" is gitignored, so each developer keeps their own private config.

# --- Database (use your own MySQL instance) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glasses_management
DB_USERNAME=root
DB_PASSWORD=yourpassword

# --- JWT (generate your own:  openssl rand -base64 32) ---
JWT_SECRET=replace-with-your-own-generated-secret
JWT_EXPIRATION_MINUTES=60

# --- Admin account (auto-created on startup by AdminConfig) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
