# Copy this file to .env and fill in real values. Used by docker-compose.yml.
#
# PostgreSQL. Take these five from the Aiven service's connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Leave DB_SSLMODE at `prefer` unless connections fail. The defaults below match
# the postgres service in docker-compose.yml, for local development.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=glasses_management
DB_USERNAME=glasses_user
DB_PASSWORD=change_me

# TLS. `prefer` negotiates TLS when the server offers it and falls back to
# plaintext when it does not, so it works against both Aiven and a local
# database. Use `require` to enforce TLS, `disable` for a plaintext-only server.
DB_SSLMODE=prefer

# Credentials for the pgadmin container (http://localhost:8081) when using
# docker-compose. Any values work; they only gate the pgadmin login screen.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Base64-encoded secret, at least 32 bytes when decoded (HS256).
JWT_SECRET=your-long-secretkey
JWT_EXPIRATION_MINUTES=60

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Set to false to skip seeding the 10 sample products on startup
SEED_PRODUCTS=true

# Public base URL used for QR codes, e.g. https://your-app.trycloudflare.com
APP_BASE_URL=http://localhost:8080

# Google sign-in. Paste the OAuth 2.0 client id from Google Cloud Console.
# This value is public and is also needed in the frontend as VITE_GOOGLE_CLIENT_ID.
# There is no client secret: the frontend only forwards the Google ID token and
# this backend verifies it with Google's public signing keys.
GOOGLE_CLIENT_ID=

# Comma-separated list of staff emails that may sign in with Google.
# ADMIN/STAFF/OPTOMETRIST accounts are rejected unless listed here.
# Customers do not need to be listed.
GOOGLE_ALLOWED_STAFF_EMAILS=

# Cloudflare tunnel (set automatically by qr-watcher container)
# Leave empty to fall back to APP_BASE_URL
APP_TUNNEL_URL_FILE=/qr-data/tunnel-url.txt
APP_TUNNEL_QR_FILE=/qr-data/qr-code.png
